<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Cuenta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2DA036"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Campo: Nombre -->
        <LinearLayout
            android:id="@+id/llNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvTituloRegistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nombre"
                android:textColorHint="#666666"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Campo: Apellido -->
        <LinearLayout
            android:id="@+id/llApellido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/llNombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person" />

            <EditText
                android:id="@+id/etApellido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Apellido"
                android:textColorHint="#666666"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Campo: Matrícula -->
        <LinearLayout
            android:id="@+id/llMatricula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/llApellido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_matricula" />

            <EditText
                android:id="@+id/etMatricula"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Matrícula"
                android:textColorHint="#666666"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="number" />
        </LinearLayout>

        <!-- Campo: Correo -->
        <LinearLayout
            android:id="@+id/llCorreo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/llMatricula"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_email" />

            <EditText
                android:id="@+id/etCorreoRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Correo electrónico"
                android:textColorHint="#666666"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Campo: Contraseña -->
        <LinearLayout
            android:id="@+id/llPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/llCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock" />

            <EditText
                android:id="@+id/etPasswordRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Contraseña"
                android:textColorHint="#666666"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="textPassword" />
        </LinearLayout>


        <!-- Mensaje de requisitos -->
        <TextView
            android:id="@+id/tvRequisitos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="La contraseña debe tener:\n• Al menos una mayúscula\n• Al menos una minúscula\n• Al menos un número\n• Al menos un caracter especial\n• Mínimo 4 caracteres"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/llPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón Registrar -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Registrarse"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#2DA036"
            app:layout_constraintTop_toBottomOf="@id/tvRequisitos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Link: Ya tengo cuenta -->
        <TextView
            android:id="@+id/tvYaTengoCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/btnRegistrar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
